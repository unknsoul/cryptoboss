{
  "_metadata": {
    "version": "v12.0-PRODUCTION-FINAL",
    "schema": "cryptoboss-config-v12",
    "created": "2026-04-23",
    "target_repo": "https://github.com/unknsoul/cryptoboss",
    "upgrade_from": "v11.0-FINAL",
    "architecture_level": "10.0",
    "target_architecture": "Context-First SMC/ICT Discretionary Trader + Scalper",
    "status": "PRODUCTION-READY-FOR-TESTING",
    "note_on_model": "User requested 'gpt-5.3-codex' which does not exist as of April 2026. Config uses 'gpt-4o' (latest stable OpenAI model). Replace with 'o3' or future model string when available.",
    "strategy_philosophy": "Structure-first. Read market context from HTF, derive bias, identify liquidity pools, wait for sweep+confirmation at premium/discount OB/FVG zones, enter only with MTF confluence. No forced trades."
  },

  "system": {
    "name": "CryptoBoss",
    "version": "v12.0",
    "mode": "paper",
    "environment": "testnet",
    "exchange": "binance",
    "base_currency": "USDT",
    "initial_capital_usdt": 10000.0,
    "max_concurrent_positions": 3,
    "allow_simultaneous_long_short": false,
    "startup_mode": "cold_start_with_validation",
    "health_check_interval_seconds": 30,
    "main_loop_interval_seconds": 5,
    "data_fetch_concurrency": 5,
    "enable_paper_mode_slippage": true,
    "enable_paper_mode_fees": true,
    "timezone": "UTC"
  },

  "environment_config": {
    "live": {
      "rest_endpoint": "https://api.binance.com/api",
      "ws_endpoint": "wss://stream.binance.com:9443/ws",
      "env_tag": "LIVE_EXCHANGE",
      "ui_banner_color": "RED",
      "ui_banner_text": "LIVE TRADING - REAL FUNDS AT RISK"
    },
    "testnet": {
      "rest_endpoint": "https://testnet.binance.vision/api",
      "ws_endpoint": "wss://testnet.binance.vision/ws",
      "env_tag": "TESTNET_EXCHANGE",
      "ui_banner_color": "ORANGE",
      "ui_banner_text": "TESTNET MODE - Simulated Funds"
    },
    "paper": {
      "rest_endpoint": null,
      "ws_endpoint": "wss://stream.binance.com:9443/ws",
      "env_tag": "SIMULATED",
      "ui_banner_color": "BLUE",
      "ui_banner_text": "PAPER TRADING - No Real Money"
    },
    "environment_guard": {
      "immutable_after_startup": true,
      "mixed_environment_rendering_blocked": true,
      "every_response_must_include_env_signature": true,
      "stale_data_threshold_seconds": 60,
      "stale_data_action": "WARN_AND_HALT_NEW_ENTRIES"
    }
  },

  "symbols": [
    {
      "pair": "BTCUSDT",
      "display": "Bitcoin",
      "rank": 1,
      "enabled": true,
      "min_trade_usdt": 20,
      "max_position_usdt": 2000,
      "tick_size": 0.01,
      "lot_step": 0.00001,
      "funding_rate_threshold_pct": 0.1,
      "volatility_profile": "HIGH",
      "preferred_session": ["LONDON", "NEW_YORK"],
      "scalping_enabled": true,
      "swing_enabled": true
    },
    {
      "pair": "ETHUSDT",
      "display": "Ethereum",
      "rank": 2,
      "enabled": true,
      "min_trade_usdt": 15,
      "max_position_usdt": 2000,
      "tick_size": 0.01,
      "lot_step": 0.0001,
      "funding_rate_threshold_pct": 0.1,
      "volatility_profile": "HIGH",
      "preferred_session": ["LONDON", "NEW_YORK"],
      "scalping_enabled": true,
      "swing_enabled": true
    },
    {
      "pair": "SOLUSDT",
      "display": "Solana",
      "rank": 3,
      "enabled": true,
      "min_trade_usdt": 10,
      "max_position_usdt": 1500,
      "tick_size": 0.001,
      "lot_step": 0.01,
      "funding_rate_threshold_pct": 0.12,
      "volatility_profile": "VERY_HIGH",
      "preferred_session": ["LONDON", "NEW_YORK"],
      "scalping_enabled": true,
      "swing_enabled": true
    },
    {
      "pair": "BNBUSDT",
      "display": "BNB",
      "rank": 4,
      "enabled": true,
      "min_trade_usdt": 10,
      "max_position_usdt": 1500,
      "tick_size": 0.01,
      "lot_step": 0.001,
      "funding_rate_threshold_pct": 0.1,
      "volatility_profile": "HIGH",
      "preferred_session": ["LONDON", "NEW_YORK"],
      "scalping_enabled": true,
      "swing_enabled": true
    },
    {
      "pair": "XRPUSDT",
      "display": "XRP",
      "rank": 5,
      "enabled": true,
      "min_trade_usdt": 10,
      "max_position_usdt": 1000,
      "tick_size": 0.0001,
      "lot_step": 0.1,
      "funding_rate_threshold_pct": 0.15,
      "volatility_profile": "HIGH",
      "preferred_session": ["LONDON", "NEW_YORK"],
      "scalping_enabled": false,
      "swing_enabled": true
    }
  ],

  "data_pipeline": {
    "provider": "binance_ccxt",
    "cache_backend": "memory",
    "redis_enabled": false,
    "redis_url": "redis://localhost:6379/0",
    "max_candles_per_tf": 500,
    "normalization": true,
    "event_publish_on_close": true,
    "event_name": "OHLCV_UPDATED",
    "rate_limit_requests_per_minute": 1200,
    "retry_attempts": 3,
    "retry_backoff_seconds": 2,
    "warmup_candles": 200,
    "data_authenticity_tagging": true,
    "timeframes_required": ["1m", "5m", "15m", "1h", "4h", "1d", "1w"],
    "timeframe_weights": {
      "1w":  1.0,
      "1d":  0.95,
      "4h":  0.85,
      "1h":  0.75,
      "15m": 0.6,
      "5m":  0.45,
      "1m":  0.3
    }
  },

  "multi_timeframe_analysis": {
    "htf_primary": "1d",
    "htf_secondary": "4h",
    "mtf_primary": "1h",
    "mtf_secondary": "15m",
    "ltf_entry": "5m",
    "ltf_scalp": "1m",
    "cascade_rule": "HTF_BIAS_GOVERNS_ALL",
    "alignment_required": {
      "swing_trade": ["1d", "4h", "1h"],
      "intraday_trade": ["4h", "1h", "15m"],
      "scalp_trade": ["1h", "15m", "5m"]
    },
    "bias_conflict_action": "NO_TRADE",
    "minimum_aligned_tfs": 3,
    "partial_alignment_penalty": 0.3
  },

  "market_structure": {
    "enabled": true,
    "module": "src/analysis/market_structure.py",
    "class": "MarketStructureEngine",
    "swing_lookback_candles": 20,
    "swing_pivot_confirmation_candles": 3,
    "structure_types": {
      "BOS": {
        "name": "Break of Structure",
        "significance": "trend_continuation",
        "required_body_close": true,
        "weight": 0.7
      },
      "CHoCH": {
        "name": "Change of Character",
        "significance": "potential_reversal",
        "required_body_close": true,
        "weight": 0.9
      },
      "MSB": {
        "name": "Market Structure Break",
        "significance": "strong_reversal",
        "required_body_close": true,
        "weight": 1.0
      }
    },
    "trend_classification": {
      "BULLISH_TRENDING": "HH+HL pattern intact, last BOS was bullish",
      "BEARISH_TRENDING": "LH+LL pattern intact, last BOS was bearish",
      "RANGING": "No clear HH/HL or LH/LL, price oscillating between levels",
      "DISTRIBUTION": "Multiple LH failures at resistance, CHoCH pending",
      "ACCUMULATION": "Multiple HL holds at support, CHoCH pending"
    },
    "minimum_swing_size_atr_multiplier": 0.5,
    "invalidation_on_swing_fail": true
  },

  "smart_money_concepts": {
    "enabled": true,
    "module": "src/analysis/smc_engine.py",
    "class": "SMCEngine",

    "order_blocks": {
      "enabled": true,
      "detection": {
        "bullish_ob": "Last bearish candle before strong bullish impulse (BOS candle)",
        "bearish_ob": "Last bullish candle before strong bearish impulse (BOS candle)",
        "ob_minimum_impulse_atr_multiplier": 1.5,
        "ob_must_precede_bos": true,
        "ob_body_percentage_minimum": 0.4,
        "breaker_block_enabled": true,
        "breaker_block_definition": "Mitigated OB that price breaks through - flips polarity"
      },
      "mitigation": {
        "full_mitigation": "50pct_retracement_into_ob",
        "partial_mitigation_threshold": 0.3,
        "invalidation_on_full_close_through": true
      },
      "scoring": {
        "freshness_weight": 0.35,
        "impulse_strength_weight": 0.35,
        "confluence_with_sr_weight": 0.30
      },
      "max_ob_age_candles": {
        "1d": 50,
        "4h": 100,
        "1h": 200,
        "15m": 300,
        "5m": 400
      },
      "require_displacement_before_return": true
    },

    "fair_value_gaps": {
      "enabled": true,
      "detection": {
        "fvg_definition": "3-candle pattern where candle[1] body gap between candle[0] high and candle[2] low (bullish FVG) or candle[0] low and candle[2] high (bearish FVG)",
        "minimum_gap_size_atr_multiplier": 0.3,
        "minimum_gap_size_price_pct": 0.05,
        "inverse_fvg_enabled": true,
        "inverse_fvg_definition": "FVG that gets partially filled and acts as resistance/support"
      },
      "fill_levels": {
        "equilibrium_50pct": true,
        "full_fill_invalidates": true,
        "partial_fill_threshold": 0.5
      },
      "scoring": {
        "size_weight": 0.4,
        "freshness_weight": 0.35,
        "htf_alignment_weight": 0.25
      },
      "max_fvg_age_candles": {
        "4h": 80,
        "1h": 150,
        "15m": 250,
        "5m": 350
      }
    },

    "liquidity": {
      "enabled": true,
      "types": {
        "BSL": {
          "name": "Buyside Liquidity",
          "definition": "Equal highs, prior highs, trendline highs, stop clusters above price",
          "sweep_confirmation": "wick_above_with_bearish_close_below"
        },
        "SSL": {
          "name": "Sellside Liquidity",
          "definition": "Equal lows, prior lows, trendline lows, stop clusters below price",
          "sweep_confirmation": "wick_below_with_bullish_close_above"
        },
        "VOID": {
          "name": "Liquidity Void",
          "definition": "Price moved too fast leaving no orders - magnetic for return",
          "enabled": true
        }
      },
      "equal_highs_lows": {
        "tolerance_pct": 0.15,
        "minimum_touches": 2,
        "lookback_candles": 50
      },
      "sweep_detection": {
        "wick_extension_minimum_atr": 0.3,
        "close_back_inside_required": true,
        "volume_spike_on_sweep_preferred": true,
        "volume_spike_multiplier": 1.5
      },
      "hunt_premium_discount": {
        "enabled": true,
        "premium_zone_above_pct": 70,
        "discount_zone_below_pct": 30,
        "equilibrium_range_pct": 10
      }
    },

    "premium_discount_zones": {
      "enabled": true,
      "reference_swing": "last_major_swing_leg",
      "premium_threshold": 0.618,
      "discount_threshold": 0.382,
      "optimal_entry_zone": [0.618, 0.79],
      "fibonacci_levels": [0, 0.236, 0.382, 0.5, 0.618, 0.705, 0.786, 1.0],
      "bias_aligned_entries_only": true
    },

    "inducement": {
      "enabled": true,
      "definition": "Small liquidity pool intentionally swept before real move",
      "minimum_retracement_after_inducement": 0.382,
      "do_not_enter_on_inducement": true,
      "wait_for_second_sweep_confirmation": true
    },

    "displacement": {
      "enabled": true,
      "definition": "Strong impulse candle(s) with large body, minimal wick, high volume",
      "minimum_body_pct_of_range": 0.7,
      "minimum_atr_multiplier": 1.5,
      "required_before_entry": true
    }
  },

  "market_context_engine": {
    "enabled": true,
    "module": "src/analysis/market_context.py",
    "class": "MarketContextEngine",
    "update_interval_seconds": 60,
    "regime_detection": {
      "method": "composite",
      "indicators": {
        "ADX": {
          "period": 14,
          "trending_threshold": 25,
          "strong_trend_threshold": 40,
          "weight": 0.3
        },
        "ATR_normalized": {
          "period": 14,
          "high_volatility_threshold": 0.025,
          "weight": 0.25
        },
        "Hurst_exponent": {
          "lookback": 100,
          "trending_threshold": 0.55,
          "mean_reverting_threshold": 0.45,
          "weight": 0.2
        },
        "volume_trend": {
          "period": 20,
          "rising_volume_confirms_trend": true,
          "weight": 0.15
        },
        "price_compression": {
          "bbw_period": 20,
          "compression_threshold": 0.02,
          "weight": 0.1
        }
      },
      "regimes": {
        "TRENDING_BULLISH":  { "capital_allocation_pct": 100, "strategy": "OB_FVG_TREND_FOLLOW", "allowed": true },
        "TRENDING_BEARISH":  { "capital_allocation_pct": 100, "strategy": "OB_FVG_TREND_FOLLOW", "allowed": true },
        "RANGING":           { "capital_allocation_pct": 75,  "strategy": "RANGE_SCALP_SR",       "allowed": true },
        "HIGH_VOLATILITY":   { "capital_allocation_pct": 30,  "strategy": "VOLATILITY_BREAKOUT",   "allowed": true },
        "LOW_VOLATILITY":    { "capital_allocation_pct": 50,  "strategy": "ACCUMULATION_WATCH",    "allowed": false },
        "NO_TRADE":          { "capital_allocation_pct": 0,   "strategy": null,                    "allowed": false }
      }
    },
    "key_level_extraction": {
      "enabled": true,
      "sources": ["swing_highs_lows", "OB_zones", "FVG_zones", "round_numbers", "daily_open_close", "weekly_open"],
      "significance_minimum_touches": 2,
      "proximity_alert_pct": 0.3
    },
    "session_awareness": {
      "enabled": true,
      "sessions": {
        "ASIA":     { "utc_open": "00:00", "utc_close": "09:00", "liquidity": "LOW",    "trade_quality": "MODERATE" },
        "LONDON":   { "utc_open": "08:00", "utc_close": "16:00", "liquidity": "HIGH",   "trade_quality": "HIGH" },
        "NEW_YORK": { "utc_open": "13:00", "utc_close": "21:00", "liquidity": "HIGHEST","trade_quality": "HIGHEST" },
        "OVERLAP":  { "utc_open": "13:00", "utc_close": "16:00", "liquidity": "HIGHEST","trade_quality": "HIGHEST" }
      },
      "prefer_london_ny_overlap": true,
      "no_trade_30min_before_major_news": true,
      "no_trade_30min_after_major_news": true
    }
  },

  "bias_engine": {
    "enabled": true,
    "module": "src/analysis/bias_engine.py",
    "class": "BiasEngine",
    "htf_sources": ["1d", "4h"],
    "bias_types": ["BULLISH", "BEARISH", "NEUTRAL"],
    "confluence_required_tfs": 2,
    "bias_scoring": {
      "HTF_structure": 0.35,
      "OB_location": 0.25,
      "FVG_fill_direction": 0.20,
      "liquidity_swept": 0.20
    },
    "bias_confidence_levels": {
      "HIGH":    { "min_score": 0.75, "capital_multiplier": 1.0 },
      "MEDIUM":  { "min_score": 0.5,  "capital_multiplier": 0.7 },
      "LOW":     { "min_score": 0.25, "capital_multiplier": 0.0 },
      "NEUTRAL": { "min_score": 0.0,  "capital_multiplier": 0.0 }
    },
    "anti_bias_trade_block": true,
    "bias_update_interval_seconds": 300,
    "conflicting_bias_action": "NO_TRADE",
    "require_minimum_confidence": "MEDIUM"
  },

  "trade_permission_filter": {
    "enabled": true,
    "module": "src/core/trade_permission_filter.py",
    "class": "TradePermissionFilter",
    "gates": [
      {
        "id": "G1_REGIME",
        "name": "Market Regime Gate",
        "check": "regime != NO_TRADE",
        "veto_power": true,
        "veto_message": "Market regime is NO_TRADE - no entries allowed"
      },
      {
        "id": "G2_BIAS",
        "name": "HTF Bias Gate",
        "check": "bias_confidence >= MEDIUM AND trade_direction == bias_direction",
        "veto_power": true,
        "veto_message": "Trade direction conflicts with HTF bias or bias confidence too low"
      },
      {
        "id": "G3_SESSION",
        "name": "Session Quality Gate",
        "check": "session.trade_quality in [HIGH, HIGHEST]",
        "veto_power": false,
        "veto_message": "Low-liquidity session - trade quality reduced",
        "penalty_if_failed": 0.5
      },
      {
        "id": "G4_CONFLUENCE",
        "name": "Confluence Score Gate",
        "check": "confluence_score >= 0.65",
        "veto_power": true,
        "veto_message": "Insufficient confluence - minimum 65% required"
      },
      {
        "id": "G5_STRUCTURE",
        "name": "Entry Zone Structural Gate",
        "check": "entry_at_OB OR entry_at_FVG OR entry_at_liquidity_zone",
        "veto_power": true,
        "veto_message": "Entry not at a structural zone (OB/FVG/Liquidity) - rejected"
      },
      {
        "id": "G6_LIQUIDITY",
        "name": "Liquidity Sweep Gate",
        "check": "prior_liquidity_swept_in_direction",
        "veto_power": false,
        "veto_message": "No recent liquidity sweep - lower quality setup",
        "penalty_if_failed": 0.2
      },
      {
        "id": "G7_DISPLACEMENT",
        "name": "Displacement Candle Gate",
        "check": "displacement_candle_present_after_poi",
        "veto_power": false,
        "veto_message": "No displacement candle present - wait for confirmation",
        "penalty_if_failed": 0.3
      },
      {
        "id": "G8_RISK",
        "name": "Pre-Risk Sanity Gate",
        "check": "rr_ratio >= 2.0 AND sl_beyond_structural_level",
        "veto_power": true,
        "veto_message": "R:R below 2.0 or SL not beyond structural invalidation"
      }
    ],
    "all_veto_gates_must_pass": true,
    "decision_logged_always": true
  },

  "strategies": {
    "active_strategies": ["SMC_TREND_FOLLOW", "SMC_SCALPER", "RANGE_SCALP"],
    "strategy_selection_method": "regime_and_bias_driven",
    "strategy_proposal_only": true,

    "SMC_TREND_FOLLOW": {
      "name": "Smart Money Concepts Trend Follower",
      "class": "src/strategies/smc_trend_follow.py::SMCTrendFollowStrategy",
      "description": "Enters with HTF trend at premium/discount OB/FVG zones after liquidity sweep and displacement. Targets next liquidity pool.",
      "enabled": true,
      "applicable_regimes": ["TRENDING_BULLISH", "TRENDING_BEARISH"],
      "applicable_sessions": ["LONDON", "NEW_YORK", "OVERLAP"],
      "timeframe_for_entry": "15m",
      "timeframe_for_confluence": ["4h", "1h"],

      "entry_conditions": {
        "long": [
          "HTF_bias == BULLISH (4H + 1D aligned)",
          "Price in discount zone (below 50% of last swing range)",
          "Bullish OB identified on 1H or 15M",
          "Prior SSL swept (sellside liquidity taken)",
          "Displacement candle present (bullish impulse from OB)",
          "FVG present inside or above OB (confluence)",
          "15M CHoCH bullish (structure shift on LTF)",
          "No major resistance directly above entry"
        ],
        "short": [
          "HTF_bias == BEARISH (4H + 1D aligned)",
          "Price in premium zone (above 50% of last swing range)",
          "Bearish OB identified on 1H or 15M",
          "Prior BSL swept (buyside liquidity taken)",
          "Displacement candle present (bearish impulse from OB)",
          "FVG present inside or below OB (confluence)",
          "15M CHoCH bearish (structure shift on LTF)",
          "No major support directly below entry"
        ]
      },

      "entry_type": "limit",
      "entry_zone": "OB_50pct_to_OB_low",
      "entry_trigger": "first_5m_candle_close_back_above_OB_50pct",

      "stop_loss": {
        "method": "below_OB_low_plus_buffer",
        "buffer_atr_multiplier": 0.2,
        "invalidation_level": "below_displacement_origin",
        "hard_max_sl_pct": 2.0
      },

      "take_profit": {
        "method": "multi_target",
        "targets": [
          { "tp_id": "TP1", "target": "prior_swing_high_or_BSL", "portion_pct": 40, "rr_minimum": 2.0 },
          { "tp_id": "TP2", "target": "next_HTF_OB_or_FVG",      "portion_pct": 35, "rr_minimum": 3.5 },
          { "tp_id": "TP3", "target": "next_major_liquidity",     "portion_pct": 25, "rr_minimum": 5.0, "move_sl_to_be_after_tp1": true }
        ]
      },

      "confluence_scoring": {
        "HTF_OB_present":         0.20,
        "LTF_OB_present":         0.15,
        "FVG_present":            0.15,
        "liquidity_swept":        0.20,
        "displacement_present":   0.10,
        "CHoCH_on_LTF":           0.10,
        "session_quality_high":   0.05,
        "round_number_nearby":    0.05,
        "minimum_score_required": 0.65
      }
    },

    "SMC_SCALPER": {
      "name": "Smart Money Concepts Scalper",
      "class": "src/strategies/smc_scalper.py::SMCScalperStrategy",
      "description": "Fast-entry scalper on 5M/1M using OB/FVG reaction points in direction of 1H bias. Targets small liquidity pools. Short duration, high R:R.",
      "enabled": true,
      "applicable_regimes": ["TRENDING_BULLISH", "TRENDING_BEARISH", "RANGING"],
      "applicable_sessions": ["OVERLAP", "LONDON", "NEW_YORK"],
      "applicable_symbols": ["BTCUSDT", "ETHUSDT", "SOLUSDT", "BNBUSDT"],
      "timeframe_for_entry": "5m",
      "timeframe_for_confluence": ["1h", "15m"],
      "max_hold_minutes": 120,
      "max_trades_per_session": 3,

      "entry_conditions": {
        "long": [
          "1H bias BULLISH",
          "5M OB identified at discount zone",
          "Micro SSL swept on 1M or 5M",
          "Bullish displacement candle from OB on 5M",
          "1M CHoCH bullish inside OB zone"
        ],
        "short": [
          "1H bias BEARISH",
          "5M OB identified at premium zone",
          "Micro BSL swept on 1M or 5M",
          "Bearish displacement candle from OB on 5M",
          "1M CHoCH bearish inside OB zone"
        ]
      },

      "entry_type": "market_on_trigger",
      "entry_trigger": "1M_CHoCH_confirmed",

      "stop_loss": {
        "method": "below_5M_OB_low_plus_buffer",
        "buffer_atr_multiplier": 0.15,
        "hard_max_sl_pct": 0.8
      },

      "take_profit": {
        "method": "multi_target",
        "targets": [
          { "tp_id": "TP1", "target": "nearest_micro_BSL_SSL",    "portion_pct": 60, "rr_minimum": 2.0 },
