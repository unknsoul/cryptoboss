        "1H_OB_alignment":        0.25,
        "5M_OB_present":          0.20,
        "micro_liquidity_swept":  0.20,
        "1M_CHoCH":               0.20,
        "FVG_nearby":             0.15,
        "minimum_score_required": 0.65
      }
    },

    "RANGE_SCALP": {
      "name": "Range Scalper",
      "class": "src/strategies/range_scalp.py::RangeScalpStrategy",
      "description": "Identifies clear ranging markets. Buys at structural support OB, sells at structural resistance OB. Requires confirmed range boundaries.",
      "enabled": true,
      "applicable_regimes": ["RANGING"],
      "applicable_sessions": ["LONDON", "NEW_YORK"],
      "timeframe_for_entry": "15m",
      "timeframe_for_range_definition": "1h",
      "max_trades_per_range": 4,
      "range_invalidation_on_close_outside_pct": 0.3,

      "entry_conditions": {
        "long": [
          "Price at range low support OB",
          "Minimum 2 bounces from support",
          "Bullish displacement from OB",
          "No bearish OB overhead within 1.5x SL distance"
        ],
        "short": [
          "Price at range high resistance OB",
          "Minimum 2 rejections from resistance",
          "Bearish displacement from OB",
          "No bullish OB below within 1.5x SL distance"
        ]
      },

      "stop_loss": {
        "method": "outside_range_boundary_plus_buffer",
        "buffer_atr_multiplier": 0.3,
        "hard_max_sl_pct": 1.5
      },

      "take_profit": {
        "method": "range_midpoint_and_opposite_boundary",
        "targets": [
          { "tp_id": "TP1", "target": "range_midpoint",   "portion_pct": 50, "rr_minimum": 1.5 },
          { "tp_id": "TP2", "target": "opposite_boundary","portion_pct": 50, "rr_minimum": 2.5, "move_sl_to_be_after_tp1": true }
        ]
      }
    }
