# ============================================================
# CryptoBoss v4.0 - Environment Variables
# Copy to .env and fill in your credentials.
# NEVER commit .env to git.
# ============================================================

# ---- BINANCE MODE ----
# testnet or live
BINANCE_MODE=testnet

# ---- BINANCE LIVE API KEYS ----
BINANCE_API_KEY=your_live_api_key_here
BINANCE_API_SECRET=your_live_api_secret_here

# ---- BINANCE TESTNET API KEYS ----
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# ---- MT5 BROKER CREDENTIALS (price data only) ----
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=ICMarkets-Demo
# MT5_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe

# ---- DATABASE ----
DATABASE_URL=sqlite:///data/cryptoboss.db

# ---- TELEGRAM (optional) ----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ---- LOGGING ----
LOG_LEVEL=INFO
LOG_FILE=logs/cryptoboss.log
