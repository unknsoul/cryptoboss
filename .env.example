# ============================================================
# CryptoBoss v12.0 - Environment Variables
# Copy to .env and fill in your credentials.
# NEVER commit .env to git.
# ============================================================

# ---- BINANCE MODE ----
# testnet or live
BINANCE_MODE=testnet
ENVIRONMENT=PAPER
BINANCE_TESTNET_ENABLED=true

# ---- BINANCE LIVE API KEYS ----
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- BINANCE TESTNET API KEYS ----
BINANCE_TESTNET_API_KEY=8mGGgaim33FuiPZNJfX2Jb03brSXNDXD5Rfc0KtzvrMMSdqnbPt8HraBG4KIJFMI
BINANCE_TESTNET_API_SECRET=YQ972lhU1HehRzq4zq5qe2iBPK1g2X4PXvB8ZEyR5dbMEJHbKD1rd4e0svDpEW81

# ---- BINANCE FUTURES API KEYS ----
BINANCE_FUTURES_KEY=your_futures_api_key_here
BINANCE_FUTURES_SECRET=your_futures_api_secret_here
BINANCE_FUTURES_TESTNET=true

# ---- MT5 BROKER CREDENTIALS (price data only) ----
MT5_LOGIN=12345678
MT5_PASSWORD=your_mt5_password
MT5_SERVER=ICMarkets-Demo
# MT5_PATH=C:\\Program Files\\MetaTrader 5\\terminal64.exe

# ---- DATABASE ----
DATABASE_URL=sqlite:///data/cryptoboss.db
REDIS_URL=redis://localhost:6379

# ---- TELEGRAM (optional) ----
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_USER_ID=your_telegram_user_id

# ---- AI INTELLIGENCE (optional in paper/testnet, required for ai_narrative) ----
OPENAI_API_KEY=your_openai_api_key

# ---- ALERTING / WEBHOOKS (optional) ----
DISCORD_WEBHOOK_URL=your_discord_webhook_url
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=alerts@example.com
SMTP_TO=you@example.com

# ---- SECURITY (optional) ----
DB_ENCRYPTION_KEY=your_db_encryption_key

# ---- LOGGING ----
LOG_LEVEL=INFO
LOG_FILE=logs/cryptoboss.log
DECISION_LOG_PATH=logs/decisions.jsonl

# ---- ALTERNATIVE DATA (optional) ----
GLASSNODE_API_KEY=your_glassnode_api_key
CRYPTOQUANT_API_KEY=your_cryptoquant_api_key
DERIBIT_BASE_URL=https://www.deribit.com

# ---- ML / OBSERVABILITY ----
ML_RETRAIN_SCHEDULE=0 2 * * *
ML_MIN_ACCURACY_THRESHOLD=0.55
MLFLOW_TRACKING_URI=http://localhost:5000
PROMETHEUS_PORT=9090
HEALTH_PORT=8080
API_PORT=8000

# ---- WEBSOCKET ----
WS_RECONNECT_ATTEMPTS=10
WS_RECONNECT_DELAY_MAX=60
